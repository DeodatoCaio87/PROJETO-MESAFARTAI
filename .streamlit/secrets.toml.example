# Copie este arquivo para secrets.toml e NUNCA envie o arquivo real ao GitHub.
[admin]
usuario = "admin"
senha_hash = "COLE_AQUI_O_HASH_GERADO_POR_scripts/gerar_hash_senha.py"

[app]
# Identificação exigida pelo Nominatim/OpenStreetMap. Informe um e-mail real.
nominatim_user_agent = "MESAFARTAI/2.0 (contato: seu-email@gmail.com)"
contexto_geografico = "Cidade, UF, Brasil"
inserir_ongs_demonstracao = false
